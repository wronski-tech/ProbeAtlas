# Control plane image: API, worker, and admin/migration commands.
FROM python:3.11-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install ".[server]" && useradd --system --uid 10001 probeatlas
USER probeatlas
EXPOSE 8000
CMD ["probeatlas-api"]
