# Example configuration. Copy to .env (git-ignored) and adjust. No real secrets here.

# --- control plane (api, worker, probeatlas-admin) ---
PROBEATLAS_ENV=development
PROBEATLAS_DATABASE_URL=postgresql+psycopg://probeatlas:probeatlas@localhost:5432/probeatlas
PROBEATLAS_ALLOW_REGISTRATION=true
# Development only: accept private hostnames (e.g. docker service names) as targets.
PROBEATLAS_ALLOW_PRIVATE_TARGETS=false
# Optional: private CIDRs webhooks may reach (leave empty in production).
PROBEATLAS_WEBHOOK_ALLOWED_PRIVATE_CIDRS=
# Resolvers for webhook destinations (comma-separated IPs); empty = the host's resolver.
PROBEATLAS_WEBHOOK_NAMESERVERS=
# Local development convenience: a multi-use agent enrollment token (must start with pae_).
# In production, issue scoped tokens with `probeatlas-admin create-enrollment-token`.
PROBEATLAS_BOOTSTRAP_ENROLLMENT_TOKEN=pae_replace-with-a-long-random-value
PROBEATLAS_DEFAULT_MAX_MONITORS=25
PROBEATLAS_MIN_INTERVAL_SECONDS=30
PROBEATLAS_RATE_LIMIT_PER_MINUTE=300
PROBEATLAS_AUTH_RATE_LIMIT_PER_MINUTE=20
PROBEATLAS_AGENT_OFFLINE_AFTER_SECONDS=60
PROBEATLAS_RESULT_RETENTION_DAYS=30
PROBEATLAS_JOB_RETENTION_DAYS=7
PROBEATLAS_LOG_LEVEL=INFO
PROBEATLAS_LOG_FORMAT=json
# Reverse proxies (IPs/CIDRs) allowed to set X-Forwarded-For: the web server and the API load balancer.
# Empty = the TCP peer is the client.
PROBEATLAS_TRUSTED_PROXIES=
# Prometheus metrics for the API process, on a separate internal-only port (0 disables).
PROBEATLAS_API_METRICS_PORT=9101
PROBEATLAS_WORKER_METRICS_PORT=9100

# --- agent ---
PROBEATLAS_API_URL=http://localhost:8000
PROBEATLAS_AGENT_ENROLLMENT_TOKEN=pae_replace-with-a-long-random-value
PROBEATLAS_AGENT_REGION=dev-laptop
PROBEATLAS_AGENT_NAME=laptop-agent
PROBEATLAS_AGENT_COUNTRY_CODE=
PROBEATLAS_AGENT_CITY=
PROBEATLAS_AGENT_PROVIDER=
PROBEATLAS_AGENT_STATE_FILE=./agent-state.json
PROBEATLAS_AGENT_CONCURRENCY=8
PROBEATLAS_AGENT_ALLOWED_PRIVATE_CIDRS=
# Resolvers for every lookup (comma-separated IPs). Public agents: public resolvers, e.g. 1.1.1.1,8.8.8.8.
PROBEATLAS_AGENT_NAMESERVERS=

# --- web ---
# PROBEATLAS_API_URL is also read by the Next.js server to reach the API.
# Number of reverse proxies in front of the web server that append to X-Forwarded-For (0 = browsers
# connect directly; the client IP is then not forwarded to the API).
PROBEATLAS_WEB_TRUSTED_PROXY_HOPS=0

# --- CLI ---
# PROBEATLAS_API_KEY=pak_...
